{
  "name": "stevenwensley.com",
  "version": "1.1.0",
  "description": "Static site for Steven Seidenfaden Wensley (AI governance consultancy). Built with Eleventy.",
  "private": true,
  "scripts": {
    "build": "eleventy",
    "build:publish": "node scripts/build-publish.mjs",
    "serve": "eleventy --serve --port=8080",
    "test": "npx playwright test tests/ --reporter=list",
    "test:unit": "node --test tests/*.unit.mjs",
    "verify": "node scripts/build-publish.mjs && node --test tests/*.unit.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@playwright/test": "^1.64.1",
    "esbuild": "0.28.2",
    "http-server": "^14.1.1"
  }
}
