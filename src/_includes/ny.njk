{#- Design B v2 "Nordisk lys" (BYG-991). Preview-layout til de nye sider under /ny/. Altid noindex indtil Stevens production-GO i BYG-1004. -#}
<!doctype html>
<html lang="da">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="icon" href="/favicon.ico">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preload" href="/assets/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/tokens.css">
</head>
<body class="sw">
<a class="skip" href="#indhold">Spring til indhold</a>
<header><div class="w hd"><a class="brand" href="/ny/">Steven <b>Wensley</b></a><nav aria-label="Hovedmenu">
{%- for l in nyNav %}<a href="{{ l.url }}"{% if l.url == page.url %} class="on" aria-current="page"{% endif %}>{{ l.text }}</a>{% endfor -%}
<a class="btn sm" href="/ny/#kontakt">Book 30 minutter</a></nav></div></header>
<main id="indhold">
{{ content | safe }}
</main>
<footer><div class="w"><span class="ft"><span>Steven Wensley · <span class="ph">STEVEN: bekræft CVR – i dag {{ site.firma }} · CVR {{ site.cvr }}</span> · <span class="ph">STEVEN: bekræft kontakt – i dag {{ site.email }} · {{ site.telefon }}</span></span><span class="pv">Preview af design B v2 · ikke publiceret</span></span>
<nav aria-label="Fodmenu"><a href="/ny/">Forside</a>{% for l in nyNav %}<a href="{{ l.url }}">{{ l.text }}</a>{% endfor %}<a href="/privatliv/">Privatliv</a></nav></div></footer>
</body>
</html>
