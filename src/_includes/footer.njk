{# Three-column site footer. Links go to absolute URLs because some
   tools (book-session, assessment) serve from project root. #}
<footer>
  <div class="footer-content">
    {# The two footer links that pointed at /contact.html — "Book a Call" and
       "Contact" — were dead: that page has never existed. Both now point at
       /book-session.html, which is the booking page. /about.html, listed as
       broken in the same note, does exist and answers 200. #}
    <div>
      <h4>{{ site.shortName }}</h4>
      <ul>
        <li><a href="{{ site.url }}">Home</a></li>
        <li><a href="{{ site.url }}/insights">Insights</a></li>
        <li><a href="{{ site.url }}/about">About</a></li>
      </ul>
    </div>
    <div>
      <h4>Services</h4>
      <ul>
        <li><a href="{{ site.url }}/services">Advisory</a></li>
        <li><a href="{{ site.url }}/ai-governance-assessment">Assessment</a></li>
        <li><a href="{{ site.url }}/book-session">Book a Call</a></li>
      </ul>
    </div>
    <div>
      <h4>Resources</h4>
      <ul>
        <li><a href="{{ site.url }}/eu-ai-act-classifier">AI Risk Classifier</a></li>
        <li><a href="{{ site.url }}/cost-of-inaction">Cost Calculator</a></li>
        <li><a href="{{ site.url }}/book-session">Contact</a></li>
      </ul>
    </div>
  </div>
  {# The canonical hub row. Every page on the site carries the same one — the
     root pages get it from scripts/build-footer-nav.mjs, these ten templated
     articles get it from here. It is deliberately the full list, including the
     four hubs the columns above never mentioned: /workshop, /playbooks,
     /tools, /notes and /glossary. Before this row existed, exactly one page in
     the site linked to /insights and one to /glossary, and a crawler that
     followed links found neither. Keep it in sync with LINKS in that script —
     build-footer-nav.mjs --check reads these pages and fails if it drifts. -#}
  <div class="footer-bottom">
    <div data-footer-nav style="margin-bottom: 1rem;"><a href="{{ site.url }}/">Home</a> &middot; <a href="{{ site.url }}/workshop">The Factory</a> &middot; <a href="{{ site.url }}/playbooks">Playbooks</a> &middot; <a href="{{ site.url }}/services">Services</a> &middot; <a href="{{ site.url }}/tools">Tools</a> &middot; <a href="{{ site.url }}/insights">Insights</a> &middot; <a href="{{ site.url }}/notes">Notes</a> &middot; <a href="{{ site.url }}/glossary">Glossary</a> &middot; <a href="{{ site.url }}/about">About</a> &middot; <a href="{{ site.url }}/#contact">Contact</a></div>
    <p>&copy; 2026 {{ site.name }}. All rights reserved.</p>
  </div>
</footer>
